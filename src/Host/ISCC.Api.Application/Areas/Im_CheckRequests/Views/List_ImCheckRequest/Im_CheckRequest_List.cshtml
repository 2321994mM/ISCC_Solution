@model ISCC.Application.ImCheckRequests.Dtos.ImCheckRequestListResult
@using ISCC.Application.ImCheckRequests.Dtos
@{
    ViewData["PageHeading"] = L["Im_List_Title"];
    var selectApproveId = (int)ViewBag.SelectApproveId;
    var culture = (string?)ViewData["Culture"] ?? "ar";
    var dateFrom = ((DateTime)ViewBag.DateFrom).ToString("yyyy-MM-dd");
    var dateEnd = ((DateTime)ViewBag.DateEnd).ToString("yyyy-MM-dd");
    var finalResultListId = (int)ViewBag.FinalResultListId;
    var checkRequestNumber = (string?)ViewBag.CheckRequestNumber ?? string.Empty;
    var companyId = (long)ViewBag.CompanyId;

    var totalPages = Model.TotalCount == 0 ? 1 : (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize);
    var currentPage = Model.PageNumber;
}

<p>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index"
       asp-route-dateFrom="@dateFrom"
       asp-route-dateTo="@dateEnd" asp-route-selectApproveId="@selectApproveId"
       asp-route-finalResultListId="@finalResultListId" asp-route-checkRequestNumber="@checkRequestNumber"
       asp-route-companyId="@companyId">
        &larr; @L["Im_List_BackToSearch"]
    </a>
</p>

@if (Model.Items.Count == 0)
{
    <span>@L["Im_List_NoData"]</span>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead>
                <tr class="table-primary">
                    <th>@L["Im_List_ColNo"]</th>
                    <th>@L["Im_List_ColRequestNumber"]</th>
                    <th>@L["Im_List_ColImporterType"]</th>
                    <th>@L["Im_List_ColSupplier"]</th>
                    <th>@L["Im_List_ColExport"]</th>
                    <th>@L["Im_List_ColCreationDate"]</th>
                    <th>@L["Im_List_ColDetails"]</th>
                    <th>@L["Im_List_ColCommittee"]</th>
                    <th>@L["Im_List_ColResults"]</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var rowNo = (Model.PageNumber - 1) * Model.PageSize;
                }
                @foreach (var item in Model.Items)
                {
                    rowNo++;
                    <tr>
                        <td>@rowNo</td>
                        <td>@item.ImCheckRequest_Number</td>
                        <td>@item.ImporterTypeName</td>
                        <td>@item.ImporterName</td>
                        <td>@item.ExportCountryName</td>
                        <td>@(item.Creation_Date?.ToString("yyyy-MM-dd"))</td>
                        @switch (selectApproveId)
                        {
                            case 1:
                                <td>
                                    <a href='/Im_CheckRequests/Im_CheckRequestDetails/Index?ImCheckRequest_Number=@item.ImCheckRequest_Number&Outlet_ID=@item.Outlet_ID'>@L["Im_List_Details"]</a>
                                </td>
                                <td>
                                    @if (item.IsAccepted == false && item.Closed_Request == null)
                                    {
                                        @L["Im_List_NotApproved"]
                                    }
                                    else if (item.IsAccepted == true && item.Closed_Request == null)
                                    {
                                        <a href='/Committees/Committee_Im/Index?requestId=@item.Im_CheckRequest_ID&Outlet_ID=@item.Outlet_ID'>@L["Im_List_FormCommittee"]<br />@L["Im_List_ApprovedDone"]</a>
                                    }
                                    else if (item.IsAccepted == null)
                                    {
                                        @L["Im_List_NoAction"]
                                    }
                                    else if (item.Closed_Request == true)
                                    {
                                        <a href='/Committees/Committee_Im/Index?requestId=@item.Im_CheckRequest_ID&Outlet_ID=@item.Outlet_ID'>@L["Im_List_FormCommittee"]<br />@item.Name_Final_Result</a>
                                    }
                                    else if (item.Closed_Request == false)
                                    {
                                        @item.Name_Final_Result
                                    }
                                </td>
                                <td>
                                    <a href='/Committees/ImCommittee_Final_Result/Index?requestId=@item.Im_CheckRequest_ID&Outlet_ID=@item.Outlet_ID'>@L["Im_List_ShowResults"]</a>
                                </td>
                                break;
                            case 2:
                                <td>
                                    <a href='/Im_CheckRequests/Im_CheckRequestDetails/Index?ImCheckRequest_Number=@item.ImCheckRequest_Number&Outlet_ID=@item.Outlet_ID'>@L["Im_List_Details"]</a>
                                </td>
                                <td>@L["Im_List_NotApproved"]</td>
                                <td>
                                    <a href='/Committees/ImCommittee_Final_Result/Index?requestId=@item.Im_CheckRequest_ID&Outlet_ID=@item.Outlet_ID'>@L["Im_List_ShowResults"]</a>
                                </td>
                                break;
                            case 3:
                                <td>
                                    <a href='/Im_CheckRequests/Im_CheckRequestDetails/Index?ImCheckRequest_Number=@item.ImCheckRequest_Number&Outlet_ID=@item.Outlet_ID'>@L["Im_List_Details"]</a>
                                </td>
                                <td>@L["Im_List_NoAction"]</td>
                                <td>
                                    <a href='/Committees/ImCommittee_Final_Result/Index?requestId=@item.Im_CheckRequest_ID&Outlet_ID=@item.Outlet_ID'>@L["Im_List_ShowResults"]</a>
                                </td>
                                break;
                            case 4:
                                <td>
                                    <a href='/Im_CheckRequests/Im_CheckRequestDetails/Index?ImCheckRequest_Number=@item.ImCheckRequest_Number&Outlet_ID=@item.Outlet_ID'>@L["Im_List_Details"]</a>
                                </td>
                                <td>@L["Im_List_Closed"]</td>
                                <td>
                                    <a href='/Committees/ImCommittee_Final_Result/Index?requestId=@item.Im_CheckRequest_ID&Outlet_ID=@item.Outlet_ID'>@L["Im_List_ShowResults"]</a>
                                </td>
                                break;
                            case 5:
                                <td>
                                    <a href='/Im_CheckRequests/Im_CheckRequestDetails/Index?ImCheckRequest_Number=@item.ImCheckRequest_Number&Outlet_ID=@item.Outlet_ID'>@L["Im_List_Details"]</a>
                                </td>
                                <td>
                                    <a href='/Committees/Committee_Im/Index?requestId=@item.Im_CheckRequest_ID&Outlet_ID=@item.Outlet_ID'>@L["Im_List_FormCommittee"]</a>
                                </td>
                                <td>
                                    <a href='/Committees/ImCommittee_Final_Result/Index?requestId=@item.Im_CheckRequest_ID&Outlet_ID=@item.Outlet_ID'>@L["Im_List_ShowResults"]</a>
                                </td>
                                break;
                            case 6:
                                <td>
                                    <a href='/Im_CheckRequests/Im_CheckRequestDetails/Index?ImCheckRequest_Number=@item.ImCheckRequest_Number&Outlet_ID=@item.Outlet_ID'>@L["Im_List_Details"]</a>
                                </td>
                                <td>
                                    <a href='/Committees/Committee_Im/Index?requestId=@item.Im_CheckRequest_ID&Outlet_ID=@item.Outlet_ID'>@L["Im_List_FormCommittee"]<br />@item.Name_Final_Result</a>
                                </td>
                                <td>
                                    <a href='/Committees/ImCommittee_Final_Result/Index?requestId=@item.Im_CheckRequest_ID&Outlet_ID=@item.Outlet_ID'>@L["Im_List_ShowResults"]</a>
                                </td>
                                break;
                            case 7:
                                <td>
                                    <a href='/Im_CheckRequests/Im_CheckRequestDetails/Index?ImCheckRequest_Number=@item.ImCheckRequest_Number&Outlet_ID=@item.Outlet_ID'>@L["Im_List_Details"]</a>
                                </td>
                                <td>@item.Name_Final_Result</td>
                                <td>
                                    <a href='/Committees/ImCommittee_Final_Result/Index?requestId=@item.Im_CheckRequest_ID&Outlet_ID=@item.Outlet_ID'>@L["Im_List_ShowResults"]</a>
                                </td>
                                break;
                            default:
                                <td></td>
                                <td></td>
                                <td></td>
                                break;
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <nav aria-label="@L["Im_List_Title"]">
            <ul class="pagination">
                <li class="page-item @(currentPage <= 1 ? "disabled" : null)">
                    <a class="page-link" asp-action="Im_CheckRequest_List"
                       asp-route-dateFrom="@dateFrom" asp-route-dateEnd="@dateEnd"
                       asp-route-selectApproveId="@selectApproveId" asp-route-finalResultListId="@finalResultListId"
                       asp-route-CheckRequest_Number="@checkRequestNumber" asp-route-Company_ID="@companyId"
                       asp-route-page="@(currentPage - 1)">@L["Im_List_Prev"]</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">@currentPage / @totalPages</span>
                </li>
                <li class="page-item @(currentPage >= totalPages ? "disabled" : null)">
                    <a class="page-link" asp-action="Im_CheckRequest_List"
                       asp-route-dateFrom="@dateFrom" asp-route-dateEnd="@dateEnd"
                       asp-route-selectApproveId="@selectApproveId" asp-route-finalResultListId="@finalResultListId"
                       asp-route-CheckRequest_Number="@checkRequestNumber" asp-route-Company_ID="@companyId"
                       asp-route-page="@(currentPage + 1)">@L["Im_List_Next"]</a>
                </li>
            </ul>
        </nav>
    }
}