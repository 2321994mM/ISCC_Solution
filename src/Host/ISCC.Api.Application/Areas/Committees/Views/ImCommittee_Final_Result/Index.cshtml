            </div>
            <div class="modal-body">هل تريد إضافة هذا الموقف النهائى للطلب؟؟</div>
            <div class="modal-footer" style="text-align:center">
                <button type="button" class="btn btn-secondary" onClick="reply_Insert_Final_Result(this)">نعم</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">لا</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/_shared/lib/jquery/dist/jquery.min.js"></script>
    <script src="/_shared/lib/select2/js/select2.min.js"></script>
    <script>
        var visaAddEditUrl = '@Url.Action("Visa_AddEDIT", "ImCommittee_Final_Result", new { area = "Committees" })';
        var visaLabResultUrl = '@Url.Action("VisaLabResult_AddEDIT", "ImCommittee_Final_Result", new { area = "Committees" })';
        var finalResultAddEditUrl = '@Url.Action("FinalResult_AddEDIT", "ImCommittee_Final_Result", new { area = "Committees" })';
        var lotStatusLstUrl = '@Url.Action("LotStatusLst_AddEDIT", "ImCommittee_Final_Result", new { area = "Committees" })';
        var insertLotResultUrl = '@Url.Action("Insert_Lot_Result", "ImCommittee_Final_Result", new { area = "Committees" })';
        var insertVisaUrl = '@Url.Action("Insert_Im_CheckRequest_Visa", "ImCommittee_Final_Result", new { area = "Committees" })';
        var insertFinalResultUrl = '@Url.Action("Insert_Im_CheckRequest_Final_Result", "ImCommittee_Final_Result", new { area = "Committees" })';
        var deleteEmpUrl = '@Url.Action("Delete_Emp_Confirm", "ImCommittee_Final_Result", new { area = "Committees" })';
        var downloadUrl = '@Url.Action("Get_Downlood_Imge", "ImCommittee_Final_Result", new { area = "Committees" })';
        var requestErrorText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Common_ErrorOccurred"].Value));
        var deleteConfirmText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Common_ConfirmDelete"].Value));
        var deleteSuccessText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Common_DeletedSuccessfully"].Value));

        // Legacy used the alertify toast library, which is not part of the portal; a small
        // fixed-position box covers the same "success / error" feedback.
        function notify(message, isOk) {
            var box = document.getElementById('isccNotify');
            if (!box) { return; }
            box.className = 'alert ' + (isOk ? 'alert-success' : 'alert-danger');
            box.style.display = 'block';
            box.textContent = message;
            window.clearTimeout(box._t);
            box._t = window.setTimeout(function () { box.style.display = 'none'; }, 3500);
        }

        function apiSucceeded(data) {
            var result = data && (data.result || data.Result);
            if (result === 'OK') { return true; }
            notify((data && (data.message || data.Message)) || requestErrorText, false);
            return false;
        }

        function requestFailed() { notify(requestErrorText, false); }

        function closeDialog(button) {
            var modal = button && button.closest('.modal');
            if (modal && window.bootstrap) {
                window.bootstrap.Modal.getOrCreateInstance(modal).hide();
            }
        }

        function reply_click2(element) {
            $(".toggle-div2-" + element.id).toggle('fast', "linear");
        }

        function reply_click6(element) {
            var lotId = element.id.split('_')[1];
            $.post(lotStatusLstUrl, function (data) {
                if (!apiSucceeded(data)) { return; }
                $('#LotStatusLst_' + lotId).empty();
                $.each(data.options || data.Options || [], function (i, index) {
                    $('#LotStatusLst_' + lotId).append($('<option />').val(index.value).text(index.displayText));
                });
            }).fail(requestFailed);
            $(".toggle-div6-" + element.id).toggle('fast', "linear");
            $(".toggle-div55-" + element.id).toggle('fast', "linear");
            $(".toggle-div16-" + element.id).toggle('fast', "linear");
            $(".toggle-div51-" + element.id).toggle('fast', "linear");
        }

        function reply_click50(element) {
            $(".toggle-div16-" + element.id).toggle('fast', "linear");
        }

        function reply_click55(element) {
            $(".toggle-div55-" + element.id).toggle('fast', "linear");
        }

        function reply_click_display_Sample(element) {
            $(".toggle-div51-" + element.id).toggle('fast', "linear");
        }

        // حفظ موقف اللوط
        function reply_Insert_Lot_Result1(element) {
            var btnLotId = element.name;
            var lotStatusLstId = $("#LotStatusLst_" + btnLotId).val();
            if (!(lotStatusLstId > 0)) {
                notify("يجب تحديد النتيجة", false);
                return false;
            }
            document.getElementById("Lbl_ID_Lot").textContent = btnLotId;
            window.bootstrap.Modal.getOrCreateInstance(document.getElementById('saveStatus')).show();
            return false;
        }

        function reply_Insert_Lot_Result(element) {
            var btnLotId = document.getElementById("Lbl_ID_Lot").innerHTML.trim();
            var lotStatusLstId = $("#LotStatusLst_" + btnLotId).val();
            var lotStatusTxt = $('#LotStatusLst_' + btnLotId + ' :selected').text().trim().split('/')[0];
            var lotStatusSt = $('#LotStatusLst_' + btnLotId + ' :selected').text().trim().split('/')[1];
            var nots = document.getElementById("Txt_Nots_" + btnLotId).value.trim();

            var insertStatus = true;
            var rows = document.getElementById("tbody_Status_" + btnLotId).rows;
            if (rows.length > 0) {
                for (var i = 0; i < rows.length; i++) {
                    var cells = rows[i].getElementsByTagName('td');
                    var lotStatusNew = cells[2].innerHTML.trim();
                    if (lotStatusNew == lotStatusLstId) {
                        insertStatus = false;
                    }
                }
            } else {
                insertStatus = true;
            }

            if (nots == "") {
                notify("يجب ادخال ملاحظات", false);
                return;
            }
            if (!(lotStatusLstId > 0)) {
                notify("يجب تحديد النتيجة", false);
                return;
            }
            if (insertStatus != true) {
                notify("موجود مسبقا", false);
                return;
            }

            $.post(insertLotResultUrl, { Lot_Category_ID: btnLotId, IS_Status: lotStatusLstId, Nots: nots }, function (data) {
                if (!apiSucceeded(data)) { return; }
                notify("تمت الاضافة بنجاح", true);
                var tableName = "Tab_Status_" + btnLotId;
                $("#" + tableName + " tbody").append("<tr><td colspan='3'>" + nots + "</td><td colspan='3'>" + lotStatusTxt + "</td><td colspan='1'>" + lotStatusLstId + "</td><td colspan='2'>" + lotStatusSt + "</td><td colspan='3'>الموظف الحالي</td></tr>");
                if (lotStatusSt == "لا يوجد اجراء اخر") {
                    $("#" + btnLotId).attr("style", "display: none !important");
                    $("#" + tableName + " tfoot").append("<tr><td colspan='12'>تم انتهاء الاجراءت على اللوط</td></tr>");
                }
                document.getElementById('Txt_Nots_' + btnLotId).value = '';
                $("#LotStatusLst_" + btnLotId).val('0');
                closeDialog(element);
            }).fail(requestFailed);
        }

        // التأشيرة
        function reply_Insert_Visa(element) {
            var visaId = document.getElementById("Visa_Lst").value;
            var visaName = $('#Visa_Lst :selected').text();
            var fullname = $('#fullnameID').val();
            var today = new Date();
            var date = today.getDate() + '/' + (today.getMonth() + 1) + '/' + today.getFullYear();

            var insertVisa = true;
            var rows = document.getElementById("myTable2").rows;
            for (var i = 0; i < rows.length; i++) {
                var cells = rows[i].getElementsByTagName('td');
                if (cells.length > 0 && cells[0].innerHTML.indexOf(visaName) > -1) {
                    insertVisa = false;
                }
            }

            if (insertVisa != true) {
                notify("التأشيرة موجودة مسبقا", false);
                return;
            }
            if (!(visaId > 0)) {
                notify("يجب تحديد التأشيرة", false);
                return;
            }

            $.post(insertVisaUrl, { Visa_ID: visaId }, function (data) {
                if (!apiSucceeded(data)) { return; }
                notify("تمت الاضافة بنجاح", true);
                $("#Tab_Visa tbody").append("<tr><td>" + visaName + "</td><td>" + date + "</td><td>" + fullname + "</td></tr>");
                closeDialog(element);
            }).fail(requestFailed);
        }

        // موقف نهائى للطلب
        function reply_Insert_Final_Result(element) {
            var finalResultList = document.getElementById("FinalResultList").value;
            var finalResult = $('#FinalResult :selected').text();
            var finalResultId = $('#FinalResult').val();
            var fullname = $('#fullnameID').val();
            var finalResultListName = $('#FinalResultList :selected').text();
            var today = new Date();
            var date = today.getDate() + '/' + (today.getMonth() + 1) + '/' + today.getFullYear();

            var insertFinalResult = true;
            var rows = document.getElementById("myTable3").rows;
            for (var i = 0; i < rows.length; i++) {
                var cells = rows[i].getElementsByTagName('td');
                if (cells.length >= 4 && cells[3].innerHTML == finalResultListName) {
                    insertFinalResult = false;
                }
            }

            if (insertFinalResult != true) {
                notify("موقف الطلب موجود مسبقا", false);
                return;
            }
            if (!(finalResultId > 0) || !(finalResultList > 0)) {
                notify("يجب تحديد موقف الطلب", false);
                return;
            }

            $.post(insertFinalResultUrl, {
                Im_Final_Result_ID: finalResultList,
                FinalResult: finalResult,
                FinalResultList_Name: finalResultListName
            }, function (data) {
                if (!apiSucceeded(data)) { return; }
                notify("تمت الاضافة بنجاح", true);
                $("#TblFinalResult tbody").append("<tr><td>" + fullname + "</td><td>" + date + "</td><td>" + finalResult + "</td><td>" + finalResultListName + "</td></tr>");
                closeDialog(element);
            }).fail(requestFailed);
        }

        function btndownload_click(elem) {
            var path = $(elem).data('assigned-id');
            if (path) {
                window.open(downloadUrl + '?path1=' + path, "_blank");
            }
        }

        function shoooow(element) {
            window.open(downloadUrl + '?path1=' + element.id, "_blank");
        }

        function btn_Delete_click(elem) {
            var path = $(elem).data('assigned-id');
            var urlParams = new URLSearchParams(window.location.search);
            var requestId = urlParams.get('requestId');
            var parts = String(path || '').split('_');
            var committeeId = (parts[0] || '').trim();
            var employeeId = (parts[1] || '').trim();

            if (!requestId || !committeeId || !employeeId || !window.confirm(deleteConfirmText)) { return; }
            $.post(deleteEmpUrl, { requestId: requestId, Committee_ID: committeeId, Employee_ID: employeeId }, function (data) {
                if (data === 'Su') {
                    notify(deleteSuccessText, true);
                    window.location.reload();
                    return;
                }
                notify((data && (data.message || data.Message)) || requestErrorText, false);
            }).fail(requestFailed);
        }

        function tdVal(tableId, index) {
            var rows = document.getElementById(tableId).rows;
            if (rows.length > index) {
                var cells = rows[index].getElementsByTagName('td');
                return cells.length > 0 ? cells[0].innerHTML : '';
            }
            return '';
        }

        function v(data, fallback) {
            return (data === undefined || data === null || data === '' || data === 0) ? fallback : data;
        }

        $(function () {
            $("#Visa_Lst").select2({ width: "100%", dir: "rtl" });
            $("#FinalResultList").select2({ width: "100%", dir: "rtl" });

            $.post(visaAddEditUrl, function (data) {
                if (!apiSucceeded(data)) { return; }
                $('#Visa_Lst').empty();
                $('#Visa_Lst').append($('<option />').val(0).text("أختار"));
                 $.each(data.options || data.Options || [], function (i, index) {
                    $('#Visa_Lst').append($('<option />').val(index.value).text(index.displayText));
                });
            }).fail(requestFailed);

            $('#Visa_Lst').on("change", function () {
                var visaResult = document.getElementById("Visa_Lst").value;
            if (!(visaResult > 0)) { $("#visalab").empty(); return; }
                $.post(visaLabResultUrl, { VisaResult: visaResult }, function (data) {
                    if (!apiSucceeded(data)) { return; }
                    $("#visalab").empty();
                    var option = data.options || data.Options;
                    if (option) {
                        $("#visalab").append(option.description_Ar || option.Description_Ar || '');
                    }
                }).fail(requestFailed);
            });

            $('#FinalResult').on("change", function () {
                var finalResult = $('#FinalResult').val();
                if (finalResult != 0) {
                    $.post(finalResultAddEditUrl, { FinalResult: finalResult }, function (data) {
                        if (!apiSucceeded(data)) { return; }
                        $('#FinalResultList').empty();
                        $('#FinalResultList').append($('<option />').val(0).text("أختار"));
                         $.each(data.options || data.Options || [], function (i, index) {
                            $('#FinalResultList').append($('<option />').val(index.value).text(index.displayText));
                        });
                    }).fail(requestFailed);
                } else {
                    notify("يجب اختيار موقف للحجر", false);
                }
            });

            $(".quickview1").on("click", function () {
                var grossweight = $(this).data("grossweight");
                var netweight = $(this).data("netweight");
                var packagecount = v($(this).data("packagecount"), '#####');
                var packageweight = v($(this).data("packageweight"), '#####');
                var numberWoodenPackage = v($(this).data("number_wooden_package"), '#####');
                var ordertext = v($(this).data("ordertext"), '#####');
                var packagetype = v($(this).data("packagetype"), '#####');
                var reasonentry = v($(this).data("reasonentry"), '#####');
                var size = v($(this).data("size"), '#####');
                var packagebasedweight = v($(this).data("packagebasedweight"), '#####');
                var packagenetweight = v($(this).data("packagenetweight"), '#####');
                var unitsnumber = $(this).data("unitsnumber");
                var subpartname = '';
                if (v(unitsnumber, '#####') === '#####') { unitsnumber = '#####'; }
                else { subpartname = v($(this).data("subpartname"), '#####'); }
                var shipmentpolicynumber = v($(this).data("shipmentpolicynumber"), '#####');
                var growerNumber = v($(this).data("grower_number"), '#####');
                var recorded = v($(this).data("recorded"), '#####');
                var itemcat = v($(this).data("itemcat"), '#####');
                var itemcatgroup = v($(this).data("itemcatgroup"), '#####');
                var pckgematerial = v($(this).data("pckgematerial"), '#####');

                $("#modaldetails").empty();
                $("#modaldetails").append(
                    "<table id='popup'>" +
                    "<tr><td>نوع العبوة</td><td><span class='modalspan'>" + packagetype + "</span></td><td>مادة العبوة</td><td><span class='modalspan'>" + pckgematerial + "</span></td></tr>" +
                    "<tr><td>عدد العبوات</td><td><span class='modalspan'>" + packagecount + "</span><span class='red'>عبوة</span></td><td>الوزن القائم للعبوة</td><td><span class='modalspan'>" + packagebasedweight + "</span><span class='red'>كجم</span></td></tr>" +
                    "<tr><td>وزن العبوة فارغة</td><td><span class='modalspan'>" + packageweight + "</span><span class='red'>كجم</span></td><td>الوزن الصافي للعبوة</td><td><span class='modalspan'>" + packagenetweight + "</span><span class='red'>كجم</span></td></tr>" +
                    "<tr><td>الوزن الاجمالي للوط</td><td><span class='modalspan'>" + grossweight + "</span><span class='red'>كجم</span></td><td>الوزن الصافي للوط</td><td><span class='modalspan'>" + netweight + "</span><span class='red'>كجم</span></td></tr>" +
