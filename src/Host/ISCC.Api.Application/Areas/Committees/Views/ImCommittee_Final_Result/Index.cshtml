            <div class="modal-body">هل تريد حفظ هذا الموقف؟؟</div>
            <div class="modal-footer" style="text-align:center">
                <button type="button" class="btn btn-secondary" onClick="reply_Insert_Lot_Result(this)">نعم</button>
