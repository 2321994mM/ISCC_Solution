@model ImCommittee_Final_ResultDTO
@*
    "نتيجة لجان الوارد" — import committee final result.

    Ported from PlantQuar.WEB/Areas/Committees/Views/ImCommittee_Final_Result/Index.cshtml.
    Every section of the legacy page is reproduced here: the message header, the customs
    certificate block, the per-item/per-lot tables, the three committee-result tables
    (فحص / سحب / معالجة), the quarantine standing ("موقف الحجر") table, the visa block,
    the final-result block, the report links and all four modals.

    The markup is rebuilt on the current design system (Bootstrap 5 + jQuery/select2 from the
    shared bundle) instead of the legacy Bootstrap 3 / jQuery UI / timepicker / jtable stack,
    because those libraries are no longer part of the portal. The element ids and the
    toggle-* class names are kept identical to the legacy page so every bit of the original
    JavaScript keeps working.

    A note on the cross-area lookups: the legacy page called
    DE_Import/Im_Visa_Data/Visa_AddEDIT, DE_Import/Im_FinalResult_Data/FinalResult_AddEDIT and
    Imges/Downlood_Imge/Get_Downlood_Imge. Those areas are not ported yet, so the three verbs
    are served by this controller (same names) and the script points at them via @Url.Action.
    When those areas land, only the Url.Action calls below need to change.

    Committee-formation form (Save_Committe / Save_Employee / SaveCommittee, the shift grid,
    the employee search): the legacy view only carried the JS for it — the matching controls
    (#CommitteeType_ID, #Next1, #ShiftsAddEdit, ...) were never rendered on this page, they
    live on the orphaned ImCommittee_New/Index. That dead script is deliberately not ported.
*@
@{
    ViewData["PageHeading"] = L["ImCommittee_FinalResult_Title"];

    if (Model is null)
    {
        return;
    }

    var fullname = ViewBag.Fullname as string;
    var committeeType = Convert.ToInt32(ViewBag.CommitteeTypeLst_Value ?? 0);
}

@section Styles {
    <link rel="stylesheet" href="/_shared/lib/select2/css/select2.min.css" />
    <style>
        @@media screen and (min-width: 768px) {
            .modal-dialog {
                left: 0% !important;
            }
        }

        #imCommitteeResult th {
            font-size: 14px;
            font-weight: bold;
            text-align: center;
        }

        #imCommitteeResult td {
            font-size: 12px;
            text-align: center;
        }

        #imCommitteeResult table, #imCommitteeResult table td, #imCommitteeResult table th {
            border: 1px solid black !important;
            border-collapse: collapse;
            word-break: keep-all;
        }

        .modal-header {
            background-color: #1e7c80;
            color: white;
        }

        .modal-content {
            color: #167479;
        }

        .display-none {
            display: none;
        }

        .style-but {
            height: auto !important;
            color: white;
            background-color: #1e7c80;
            border: 2px solid #1e8084;
            box-shadow: 0 4px #1d9fa5;
            outline: none;
            margin-top: 5px;
        }

        .tapp-title {
            background-color: #1e7c80;
            color: #fff;
            padding: 5px 12px;
            display: inline-block;
        }

        .tab .nav-tabs {
            border-bottom: 1px solid #1e7c80;
        }

        .tab .nav-tabs > li > a,
        .tab .nav-tabs button {
            color: #1e7c80;
        }

        .tab .nav-tabs .active a,
        .tab .nav-tabs .active button {
            background-color: #1e7c80 !important;
            color: #fff !important;
        }

        #popup td, #popup th {
            padding: 4px 8px;
        }

        .padding-left-50 {
            padding-left: 50px !important;
        }

        .labelspan {
            color: #888;
        }

        .red {
            color: red;
        }
    </style>
}

<div id="imCommitteeResult">

    @* ============================ بيانات الرسالة ============================ *@
    <div class="row">
        <label class="tapp-title">بيانات الرسالة</label>
    </div>
    <br />
    <div class="row">
        <div class="col-md-6">
            <div class="row">
                <div class="col-md-3">
                    <label>رقم الطلب/</label>
                </div>
                <div class="col-md-9">
                    <a href="/Im_CheckRequests/Im_CheckRequestDetails/Index?ImCheckRequest_Number=@Model.ImCheckRequest_Number&Outlet_ID=@Model.OutLet_ID">@Model.ImCheckRequest_Number</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row">
                <div class="col-md-3">
                    <label>تاريخ الطلب/</label>
                </div>
                <div class="col-md-9">
                    <input type="text" value="@Model.StartDate" readonly class="form-control" />
                </div>
            </div>
        </div>
    </div>
    <br />

    @* ======================== بيانات الشهادة الجمركية ======================== *@
    <div class="row">
        <label class="tapp-title">بيانات الشهادة الجمركية</label>
        <label hidden id="Lbl_ID_Lot"></label>
    </div>
    <br />

    @if (Model.CustomsMessages != null)
    {
        for (int cm = 0; cm < Model.CustomsMessages.Count(); cm++)
        {
            <div class="row" style="margin-bottom:5px;">
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-md-6"><label>رقم الشهادة الجمركية</label></div>
                        <div class="col-md-6">
                            <input type="text" value="@Model.CustomsMessages[cm].Customs_Certificate_Number" readonly class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-md-6"><label>تاريخ الشهادة</label></div>
                        <div class="col-md-6">
                            @if (Model.CustomsMessages[cm].Certification_Date != null)
                            {
                                <input type="text" value="@Model.CustomsMessages[cm].Certification_Date.Value.ToString("dd/MM/yyyy")" readonly class="form-control" />
                            }
                            else
                            {
                                <input type="text" value="لا يوجد تاريخ الشهادة" readonly class="form-control" />
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="row" style="margin-bottom:5px;">
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-md-6"><label>تاريخ الشحن</label></div>
                        <div class="col-md-6">
                            @if (Model.CustomsMessages[cm].Shipment_Date != null)
                            {
                                <input type="text" value="@Model.CustomsMessages[cm].Shipment_Date.Value.ToString("dd/MM/yyyy")" readonly class="form-control" />
                            }
                            else
                            {
                                <input type="text" value="لا يوجد تاريخ الشحن" readonly class="form-control" />
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-md-6"><label>تاريخ الوصول</label></div>
                        <div class="col-md-6">
                            @if (Model.CustomsMessages[cm].Arrival_Date != null)
                            {
                                <input type="text" value="@Model.CustomsMessages[cm].Arrival_Date.Value.ToString("dd/MM/yyyy")" readonly class="form-control" />
                            }
                            else
                            {
                                <input type="text" value="لا يوجد تاريخ وصول" readonly class="form-control" />
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="row" style="margin-bottom:5px;">
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-md-6"><label>رقم الشهادة لكل منتج</label></div>
                        <div class="col-md-6">
                            <input type="text" value="@Model.CustomsMessages[cm].Certificate_Number_Each_Product" readonly class="form-control" />
                        </div>
                    </div>
                </div>
                <input id="fullnameID" type="hidden" value="@fullname" />
                <div class="col-md-6">
                    <div class="row" style="margin-bottom:5px;">
                        <div class="col-md-6"><label>رقم المنافيست</label></div>
                        <div class="col-md-6">
                            <input type="text" value="@Model.CustomsMessages[cm].Manifest_Number" readonly class="form-control" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="row" style="margin-bottom:5px;">
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-md-6"><label>التوكيل الملاحي</label></div>
                        <div class="col-md-6">
                            <input type="text" value="@Model.CustomsMessages[cm].Shipping_Agency_Name" readonly class="form-control" />
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    <hr />

    @* ============================== النباتات ============================== *@
    <div class="form-box" id="lagnaDiv">
        <div class="tab" role="tabpanel">
            <ul class="row nav nav-tabs" role="tablist">
                <li role="presentation" class="nav-item">
                    <a class="nav-link active" href="#link" role="tab" data-bs-toggle="tab">بيانات الرسالة</a>
                </li>
            </ul>
            <div class="tab-content tabs" style="background-color:whitesmoke !important;">
                <div role="tabpanel" class="tab-pane fade show active" id="link">
                    <div id="MessageData" style="padding:10px;">
                        <div class="row">
                            <div class="col-md-12">

                                @if (Model.itemsWithConstrains != null)
                                {
                                    for (int i = 0; i < Model.itemsWithConstrains.Count(); i++)
                                    {
                                        var item = Model.itemsWithConstrains[i];
                                        <table id="itemTable" class="table" style="border: 5px solid #1f6c6f !important;">
                                            <tbody>
                                                <tr style="background-color: rgb(77,158,151); color:#fff; font-weight:bold; font-size:16px;" class="toggle-div-@i">
                                                    <td colspan="12" style="font-size:inherit">النبات</td>
                                                </tr>
                                                <tr class="toggle-div-@i">
                                                    <th style="background-color: rgb(77,158,151) !important;">أسم النبات</th>
                                                    <th style="background-color: rgb(77,158,151) !important;">النوع(مجموعة نوعية/نبات)</th>
                                                    <th style="background-color: rgb(77,158,151) !important;" colspan="2">الاسم المختصر</th>
                                                    <th style="background-color: rgb(77,158,151) !important;" colspan="2">دولة المنشأ</th>
                                                    <th style="background-color: rgb(77,158,151) !important;" colspan="2">الوزن الإجمالي</th>
                                                    <th style="background-color: rgb(77,158,151) !important;">الوزن الصافي</th>
                                                    <th colspan="3" style="background-color: rgb(77,158,151) !important;">النبات</th>
                                                </tr>
                                                <tr class="toggle-div-@i">
                                                    <td>@item.ItemName_Ar</td>
                                                    <td>@item.qualitiveGroupName</td>
                                                    <td colspan="2">@item.ItemShortNameAr</td>
                                                    <td colspan="2">@item.InitiatorCountry</td>
                                                    <td colspan="2">@item.GrossWeight</td>
                                                    <td>@item.Net_Weight</td>
                                                    <td colspan="3">
                                                        <input id="Lot_@i" class="style-but" type="button" onClick="reply_click2(this)" value="بيانات اللوط" style="background-color:#CE9461 !important;" />
                                                    </td>
                                                </tr>
                                                <tr style="background-color:#CE9461 !important; color:rgb(255,255,255); font-weight:bold; font-size:16px;" class="display-none toggle-div2-Lot_@i">
                                                    <td colspan="12" style="font-size:inherit">بيانات اللوط</td>
                                                </tr>
                                                <tr class="display-none toggle-div2-Lot_@i">
                                                    <th style="background-color:#CE9461 !important">رقم اللوط</th>
                                                    <th hidden style="background-color:#CE9461 !important">أسم الصنف</th>
                                                    <th style="background-color:#CE9461 !important">وزن إجمالي</th>
                                                    <th style="background-color:#CE9461 !important">وزن صافي</th>
                                                    <th style="background-color:#CE9461 !important">عدد العبوات</th>
                                                    <th style="background-color:#CE9461 !important">وزن العبوات</th>
                                                    <th style="background-color:#CE9461 !important">طريقة الفحص</th>
                                                    <th style="background-color:#CE9461 !important">اضافة</th>
                                                    <th colspan="2" style="background-color:#CE9461 !important">رقم الحاوية</th>
                                                    <th colspan="2" style="background-color:#CE9461 !important">التفاصيل</th>
                                                    <th style="background-color:#CE9461 !important">موقف الحجر</th>
                                                </tr>

                                                @for (int m = 0; m < item.ItemCategories_lots.Count(); m++)
                                                {
                                                    var lot = item.ItemCategories_lots[m];
                                                    <tr class="display-none toggle-div2-Lot_@i">
                                                        <td>@lot.Lot_Number</td>
                                                        <td class="hidden">@lot.categoryName</td>
                                                        <td>@lot.GrossWeight</td>
                                                        <td>@lot.Net_Weight</td>
                                                        <td>@lot.Package_Count</td>
                                                        <td>@lot.Package_Weight</td>
                                                        <td></td>
                                                        <td>
                                                            <input id="Lot_Result_@lot.ID_Lot" class="style-but" type="button" onClick="reply_click6(this)" value="النتائج السابقة" style="background-color:#c1b88c!important" />
                                                        </td>
                                                        <td colspan="2">
                                                            <button type="button" class="quickview3 style-but" data-bs-toggle="modal"
                                                                    data-bs-target="#mymodalemanexamination"
                                                                    data-containernumber="@lot.ContainerNumber"
                                                                    data-contid="@lot.containerName"
                                                                    data-containerstypeid="@lot.containerType"
                                                                    data-shipholdnumber="@lot.ShipholdNumber"
                                                                    data-navigationalnumber="@lot.NavigationalNumber"
                                                                    data-totalweight="@lot.Total_Weight">
                                                                تفاصيل الحاوية
                                                            </button>
                                                        </td>
                                                        <td colspan="2">
                                                            <button type="button" class="quickview1 style-but" data-bs-toggle="modal"
                                                                    data-bs-target="#mymodalemanexamination"
                                                                    data-grossweight="@lot.GrossWeight"
                                                                    data-netweight="@lot.Net_Weight"
                                                                    data-packagecount="@lot.Package_Count"
                                                                    data-packageweight="@lot.Package_Weight"
                                                                    data-ordertext="@lot.Order_TextLot"
                                                                    data-recorded="@lot.RecordedOrNot"
                                                                    data-packagetype="@lot.packageType"
                                                                    data-reasonentry="@lot.Reason_Entry"
                                                                    data-size="@lot.Size"
                                                                    data-basedweight="@lot.Based_Weight"
                                                                    data-pckgematerial="@lot.packageMaterialName"
                                                                    data-packagebasedweight="@lot.Package_Based_Weight"
                                                                    data-packagenetweight="@lot.Package_Net_Weight"
                                                                    data-unitsnumber="@lot.Units_Number"
                                                                    data-subpartname="@item.subPartName"
                                                                    data-itemcat="@lot.categoryName"
                                                                    data-itemcatgroup="@lot.ItemCategoryGroup"
                                                                    data-grower_number="@lot.Grower_Number"
                                                                    data-number_wooden_package="@lot.Number_Wooden_Package"
                                                                    data-shipmentpolicynumber="@lot.Waybill">
                                                                تفاصيل اللوط
                                                            </button>
                                                        </td>
                                                        <td>
                                                            <input class="style-but" id="stonestand_@lot.ID_Lot" type="button"
                                                                   onClick="reply_click6(this)" value="موقف الحجر" style="background-color:#8e3200cc!important;" />
                                                        </td>
                                                    </tr>

                                                    bool finalResultLotInsert;
                                                    {
                                                        // Ported from the legacy inline block: a lot becomes eligible for a
                                                        // quarantine standing only after its inspection and/or sample
                                                        // committee work is complete.
                                                        bool resultLotCommitteeResult = false;
                                                        bool resultLotCommitteeSample = false;
                                                        int committeeResultFa7s = 0;
                                                        int committeeResultSample = 0;

                                                        var inspection = lot.Lot_Committee_Result ?? new List<Committee_Result_Lot>();
                                                        var samples = lot.List_Lot_Committee_Sample ?? new List<Committee_Sample_Lot>();

                                                        if (committeeType == 11 || committeeType == 0)
                                                        {
                                                            if (inspection.Count > 0)
                                                            {
                                                                for (int b = 0; b < inspection.Count; b++)
                                                                {
                                                                    committeeResultFa7s = 1;
                                                                    if (inspection.Where(a => a.ResultTypes_Name != null).Any())
                                                                    {
                                                                        var confirms = inspection[b].List_Committee_Result_Conferm ?? new List<Committee_Result_Lot_Conferm>();
                                                                        if (confirms.Where(a => a.User_Deletion_Id == null && a.User_Deletion_Date == null).Count() > 0)
                                                                        {
                                                                            if (confirms.Where(a => a.IsAccepted == null && a.User_Deletion_Id == null && a.User_Deletion_Date == null).Any())
                                                                            {
                                                                                resultLotCommitteeResult = false;
                                                                            }
                                                                            else
                                                                            {
                                                                                resultLotCommitteeResult = true;
                                                                            }
                                                                        }
                                                                        else
                                                                        {
                                                                            resultLotCommitteeResult = true;
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }

                                                        if (committeeType == 13 || committeeType == 0)
                                                        {
                                                            if (samples.Count > 0)
                                                            {
                                                                committeeResultSample = 2;
                                                                if (samples.Where(a => a.IsAccepted != null).Any())
                                                                {
                                                                    if (samples.Where(a => (a.List_Committee_Sample_Conferm ?? new List<Committee_Sample_Conferm>()).Count() > 0).Any())
                                                                    {
                                                                        if (samples.Where(a => a.IsAccepted == null).Any())
                                                                        {
                                                                            resultLotCommitteeSample = false;
                                                                        }
                                                                        else
                                                                        {
                                                                            resultLotCommitteeSample = true;
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        if (samples.Where(a => a.IsAccepted != null).Any())
                                                                        {
                                                                            resultLotCommitteeSample = true;
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }

                                                        if (committeeResultFa7s == 1 && committeeResultSample == 2)
                                                        {
                                                            finalResultLotInsert = resultLotCommitteeResult == resultLotCommitteeSample && resultLotCommitteeSample;
                                                        }
                                                        else if (committeeResultFa7s == 1)
                                                        {
                                                            finalResultLotInsert = resultLotCommitteeResult;
                                                        }
                                                        else
                                                        {
                                                            finalResultLotInsert = false;
                                                        }
                                                    }

                                                    @* ---------------- نتيجة الفحص (معاينة) ---------------- *@
                                                    if (committeeType == 11 || committeeType == 0)
                                                    {
                                                        var inspection = lot.Lot_Committee_Result ?? new List<Committee_Result_Lot>();
                                                        if (inspection.Count() > 0)
                                                        {
                                                            <tr style="background-color:#c1b88c !important; color:rgb(255,255,255); font-weight:bold; font-size:16px;"
                                                                class="display-none toggle-div6-Lot_Result_@lot.ID_Lot">
                                                                <td colspan="12" style="font-size:inherit">
                                                                    <input id="Lot_Result_@lot.ID_Lot" class="style-but" type="button" onClick="reply_click50(this)" value="نتيجة معاينة لوط رقم : @lot.Lot_Number اضغط هنا" />
                                                                </td>
                                                            </tr>
                                                            <tr class="display-none toggle-div16-Lot_Result_@lot.ID_Lot">
                                                                <th colspan="6" style="background-color:#c1b88c!important">نتيجة المعاينة أدمن</th>
                                                                <th colspan="1" style="background-color:#c1b88c!important">طريقة فحص اللجنة للوط</th>
                                                                <th colspan="5" style="background-color:#c1b88c!important">نتيجة معاينة المساعد</th>
                                                            </tr>
                                                            for (int a = 0; a < inspection.Count(); a++)
                                                            {
                                                                var adminResult = inspection[a];
                                                                var infections = adminResult.List_Im_CommitteeResult_Infection ?? new List<List_Im_CommitteeResult_Infection>();
                                                                var attachments = lot.AttachmentData_Im_CommitteeResult_Infection;
                                                                var adminConfirms = adminResult.List_Committee_Result_Conferm;
                                                                <tr class="display-none toggle-div16-Lot_Result_@lot.ID_Lot">
                                                                    <td colspan="6">
                                                                        <div class="row">
                                                                            @if (adminResult.ResultTypes_Name != null)
                                                                            {
                                                                                <div class="col-md-6">@adminResult.ResultTypes_Name</div>
                                                                            }
                                                                            else
                                                                            {
                                                                                <div class="col-md-6">لا توجد نتيجة</div>
                                                                            }
                                                                            <div class="col-md-6">
                                                                                <button type="button" class="quickview4 style-but" data-bs-toggle="modal"
                                                                                        data-bs-target="#mymodalemanexamination"
                                                                                        data-delegationdate="@(adminResult.Delegation_Date?.ToString("dd/MM/yyyy"))"
                                                                                        data-status="@adminResult.Status"
                                                                                        data-isfinishedall="@adminResult.IsFinishedAll"
                                                                                        data-employeeid="@adminResult.EmployeeId"
                                                                                        data-employeename="@adminResult.Employee_Name"
                                                                                        data-starttime="@adminResult.StartTime"
                                                                                        data-endtime="@adminResult.EndTime"
                                                                                        data-notes="@adminResult.Notes">
                                                                                    تفاصيل
                                                                                </button>
                                                                            </div>
                                                                        </div>

                                                                        @if (infections.Count() > 0)
                                                                        {
                                                                            <div class="row" style="margin-top:20px;">
                                                                                <div class="col-md-12">
                                                                                    <table id="popup">
                                                                                        <thead>
                                                                                            <tr>
                                                                                                <th hidden="hidden">الرقم</th>
                                                                                                <th hidden="hidden">رقم الافة</th>
                                                                                                <th hidden="hidden">رقم النتيجة</th>
                                                                                                <th>اسم الافة</th>
                                                                                                <th>اسم الافة العلمى</th>
                                                                                                <th>تفاصيل</th>
                                                                                            </tr>
                                                                                        </thead>
                                                                                        <tbody>
                                                                                            @for (int c = 0; c < infections.Count(); c++)
                                                                                            {
                                                                                                var inf = infections[c];
                                                                                                <tr>
                                                                                                    <td hidden="hidden">@inf.ID</td>
                                                                                                    <td hidden="hidden">@inf.Item_ID</td>
                                                                                                    <td hidden="hidden">@inf.Im_CommitteeResult_ID</td>
                                                                                                    <td>@inf.Item_Name</td>
                                                                                                    <td>@inf.Scientific_Name</td>
                                                                                                    <td style="padding-bottom:10px;">
                                                                                                        <button type="button" class="quickview6 style-but" data-bs-toggle="modal"
                                                                                                                data-bs-target="#mymodalemanexamination"
                                                                                                                data-itemname="@inf.Item_Name"
                                                                                                                data-mainname="@inf.Main_Classification_Name"
                                                                                                                data-secondaryname="@inf.Secondary_Classification_Name"
                                                                                                                data-groupname="@inf.Group_Name"
                                                                                                                data-kingdomname="@inf.KingdomName"
                                                                                                                data-phylumsub="@inf.PhylumSubphylumName"
                                                                                                                data-famliyname="@inf.FamliyName"
                                                                                                                data-scientificname="@inf.Scientific_Name"
                                                                                                                data-description="@inf.Description"
                                                                                                                data-isplantegypt="@inf.Is_Plant_Egypt"
                                                                                                                data-isforbidden="@inf.Is_Forbidden"
                                                                                                                data-isforbiddenreason="@inf.Is_Forbidden_Reason"
                                                                                                                data-isknownitem="@inf.Is_Known_Item"
                                                                                                                data-ordername="@inf.Order_Name"
                                                                                                                data-picture="@inf.Picture">
                                                                                                            تفاصيل الآفة
                                                                                                        </button>
                                                                                                    </td>
                                                                                                </tr>
                                                                                            }
                                                                                        </tbody>
