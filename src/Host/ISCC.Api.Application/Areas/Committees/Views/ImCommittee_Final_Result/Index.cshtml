                                                            <td colspan="12">لم يتم عمل اللجان حتى يتثنى لك العمل على موقف اللوط</td>
                                                        </tr>
                                                    }
                                                }

                                                <tr class="display-none toggle-div4-@i@i@i@i">
                                                    <td colspan="6"><label>نوع اللجنة</label></td>
                                                    <td colspan="6"></td>
                                                </tr>
                                                <tr class="display-none toggle-div5-@i@i@i@i">
                                                    <td colspan="6"></td>
                                                    <td colspan="6"></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                        <br />
                                        <hr style="border-top: 1px solid #848484;" />
                                        <br />
                                    }
                                }

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <hr />

    @* ============================== التأشيرة ============================== *@
    <div class="row">
        <label class="tapp-title">التأشيرة</label>
    </div>
    <br />
    <div class="row">
        <div class="col-md-12">
            <a href='/Committees/FeesTotalResult/Index?ImCheckRequest_Number=@Model.ImCheckRequest_Number' class="btn btn-primary" style="background-color:#1f6c6f; border-color:#1f6c6f;">عرض الرسوم</a>
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-4">
            <input type="text" value="نص التأشيرة" readonly class="form-control" />
            <select class="form-control" id="Visa_Lst"></select>
            <textarea id="visalab" class="form-control" disabled></textarea>
            <br />
            <button type="button" class="quickview10 style-but" data-bs-toggle="modal" data-bs-target="#mytextVisa">
                حفظ التأشيرة
            </button>
        </div>
        <div class="col-md-8">
            <table id="Tab_Visa" class="table table-bordered table-striped" role="grid" style="padding:5px; width:100%">
                <thead>
                    <tr>
                        <th>نص التأشيرة</th>
                        <th>التاريخ</th>
                        <th>اسم الموظف</th>
                    </tr>
                </thead>
                <tbody id="myTable2">
                    @if (Model.CheckRequest_Visa != null)
                    {
                        for (int cm = 0; cm < Model.CheckRequest_Visa.Count(); cm++)
                        {
                            <tr>
                                <td>
                                    <textarea style="width:100%;" rows="4" disabled>@Model.CheckRequest_Visa[cm].Visa_Result_Name</textarea>
                                </td>
                                <td>@(Model.CheckRequest_Visa[cm].Date_Visa?.ToString("dd/MM/yyyy"))</td>
                                <td>@Model.CheckRequest_Visa[cm].Visa_Result_Employee_Name</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <hr />

    @* ============================ الموقف النهائي ============================ *@
    <div class="row">
        <div class="col-md-4">
            <select class="form-control" id="FinalResult" name="FinalResult">
                <option value="0">أختار</option>
                <option id="FinalResult_worked" value="1">الطلب يعمل</option>
                @if (Model.Count_Lots == 0)
                {
                    <option id="FinalResult_notworked" value="2">الطلب لا يعمل</option>
                }
            </select>
            <select class="form-control" id="FinalResultList" name="FinalResultList"></select>
            <br />
            <button type="button" class="quickview17 style-but" data-bs-toggle="modal" data-bs-target="#mytextFinalRequest">
                حفظ الموقف النهائى
            </button>
        </div>
        <div class="col-md-8">
            <table id="TblFinalResult" class="table table-bordered table-striped" role="grid" style="padding:5px; width:100%">
                <thead>
                    <tr>
                        <th>اسم الموظف</th>
                        <th>تاريخ الطلب</th>
                        <th>حالة الطلب</th>
                        <th>الموقف النهائي للطلب</th>
                    </tr>
                </thead>
                <tbody id="myTable3">
                    @if (Model.FinalResults != null)
                    {
                        for (int cm = 0; cm < Model.FinalResults.Count(); cm++)
                        {
                            <tr>
                                <td>@Model.FinalResults[cm].Final_Result_Employee_Name</td>
                                <td>@(Model.FinalResults[cm].DateFinalResult?.ToString("dd/MM/yyyy"))</td>
                                @if (Model.FinalResults[cm].Final_Result_Status == true)
                                {
                                    <td>الطلب يعمل</td>
                                }
                                else
                                {
                                    <td>الطلب لا يعمل</td>
                                }
                                <td>@Model.FinalResults[cm].Final_Result_Name</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.Count_Lots == 0)
    {
        <br />
        <hr />
        <div class="row">
            <div class="col-md-12">
                <div class="col-md-4">
                    <center><a href='/IM_Check_Requst_Report/ChooseAcceptedReport/Index?ImCheckRequest_Number=@Model.ImCheckRequest_Number' class="btn btn-primary">طباعة إستمارة الفحص</a></center>
                </div>
                <div class="col-md-4">
                    <center><a href='/Committees/RefuseResultReport/Index?ImCheckRequest_Number=@Model.ImCheckRequest_Number' class="btn btn-primary">طباعة إخبار الرفض</a></center>
                </div>
                <div class="col-md-4" style="text-align:center">
                    <center><a href='/Committees/FeesTotalResult/Index?ImCheckRequest_Number=@Model.ImCheckRequest_Number' class="btn btn-primary">عرض الرسوم</a></center>
                </div>
            </div>
        </div>
    }

</div>

@* =============================== Modals =============================== *@
