@model ISCC.Infrastructure.Data.Generated.GeneralAdmin
@using ISCC.Shared.Contracts
@{
    ViewData["PageHeading"] = L["DE_Outlets_GeneralAdmin_Edit"];
    var culture = (string?)ViewData["Culture"] ?? "ar";
    var contactTypes = (IReadOnlyList<SelectOption>?)ViewBag.ContactTypes ?? Array.Empty<SelectOption>();
    var contacts = (IReadOnlyList<dynamic>?)ViewBag.Contacts ?? Array.Empty<dynamic>();
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">@L["DE_Outlets_GeneralAdmin_Edit"]: @Model.ArName</h5>
    </div>
    <div class="card-body">
        <form method="post" asp-action="Edit" asp-route-id="@Model.Id" class="row g-3">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserCreationId" />
            <input type="hidden" asp-for="UserCreationDate" />
            <input type="hidden" asp-for="UserDeletionId" />
            <input type="hidden" asp-for="UserDeletionDate" />

            <div class="col-md-6">
                <label class="form-label" asp-for="ArName">@L["DE_Outlets_GeneralAdmin_ArName"] <span class="text-danger">*</span></label>
                <input class="form-control" type="text" asp-for="ArName" required />
                <span class="text-danger" asp-validation-for="ArName"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="EnName">@L["DE_Outlets_GeneralAdmin_EnName"] <span class="text-danger">*</span></label>
                <input class="form-control" type="text" asp-for="EnName" required />
                <span class="text-danger" asp-validation-for="EnName"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="AddressAr">@L["DE_Outlets_GeneralAdmin_AddressAr"]</label>
                <input class="form-control" type="text" asp-for="AddressAr" />
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="AddressEn">@L["DE_Outlets_GeneralAdmin_AddressEn"]</label>
                <input class="form-control" type="text" asp-for="AddressEn" />
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="AdminId">@L["DE_Outlets_GeneralAdmin_Admin"]</label>
                <input class="form-control" type="number" asp-for="AdminId" />
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="IsActive">@L["DE_Outlets_GeneralAdmin_IsActive"]</label>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" asp-for="IsActive" checked="@Model.IsActive" />
                    <label class="form-check-label" asp-for="IsActive">@L["Common_Active"]</label>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">@L["DE_Outlets_GeneralAdmin_Contacts"]</label>
                <div id="contactsContainer">
                    @{
                        var idx = 0;
                    }
                    @if (contacts.Any())
                    {
                        @foreach (var contact in contacts)
                        {
                            <div class="contact-row row g-2 mb-2">
                                <input type="hidden" name="Contacts[@idx].Id" value="@contact.Id" />
                                <div class="col-md-4">
                                    <select class="form-select contact-type" name="Contacts[@idx].ContactTypeId">
                                        <option value="">@L["Common_SelectContactType"]</option>
                                        @foreach (var ct in contactTypes)
                                        {
                                            <option value="@ct.Value" selected="@(contact.ContactTypeId.ToString() == ct.Value ? "selected" : null)">@ct.Text(culture)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <input class="form-control contact-value" type="text" name="Contacts[@idx].Value" value="@contact.Value" placeholder="@L["DE_Outlets_GeneralAdmin_ContactValue"]" />
                                </div>
                                <div class="col-md-2">
                                    <button type="button" class="btn btn-danger btn-sm remove-contact w-100" @(contacts.Count == 1 ? "disabled" : null)>@L["Common_Remove"]</button>
                                </div>
                            </div>
                            idx++;
                        }
                    }
                    else
                    {
                        <div class="contact-row row g-2 mb-2">
                            <div class="col-md-4">
                                <select class="form-select contact-type" name="Contacts[0].ContactTypeId">
                                    <option value="">@L["Common_SelectContactType"]</option>
                                    @foreach (var ct in contactTypes)
                                    {
                                        <option value="@ct.Value">@ct.Text(culture)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <input class="form-control contact-value" type="text" name="Contacts[0].Value" placeholder="@L["DE_Outlets_GeneralAdmin_ContactValue"]" />
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-danger btn-sm remove-contact w-100" disabled>@L["Common_Remove"]</button>
                            </div>
                        </div>
                    }
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm mt-2" id="addContact">@L["Common_AddContact"] <i class="bi bi-plus"></i></button>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">@L["Common_Update"]</button>
                <a class="btn btn-outline-secondary" asp-action="Index">@L["Common_Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            let contactIndex = @(contacts.Count > 0 ? contacts.Count : 1);
            const container = document.getElementById('contactsContainer');
            const addBtn = document.getElementById('addContact');

            addBtn.addEventListener('click', function () {
                const div = document.createElement('div');
                div.className = 'contact-row row g-2 mb-2';
                div.innerHTML = `
                    <div class="col-md-4">
                        <select class="form-select contact-type" name="Contacts[${contactIndex}].ContactTypeId">
                            <option value="">@L["Common_SelectContactType"]</option>
                            @foreach (var ct in contactTypes)
                            {
                                <text><option value="@ct.Value">@ct.Text(culture)</option></text>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <input class="form-control contact-value" type="text" name="Contacts[${contactIndex}].Value" placeholder="@L["DE_Outlets_GeneralAdmin_ContactValue"]" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-danger btn-sm remove-contact w-100">@L["Common_Remove"]</button>
                    </div>
                `;
                container.appendChild(div);
                updateRemoveButtons();
                contactIndex++;
            });

            container.addEventListener('click', function (e) {
                if (e.target.classList.contains('remove-contact') && !e.target.disabled) {
                    e.target.closest('.contact-row').remove();
                    updateRemoveButtons();
                }
            });

            function updateRemoveButtons() {
                const rows = container.querySelectorAll('.contact-row');
                rows.forEach((row, i) => {
                    const btn = row.querySelector('.remove-contact');
                    btn.disabled = rows.length === 1;
                    row.querySelector('select').name = `Contacts[${i}].ContactTypeId`;
                    row.querySelector('input').name = `Contacts[${i}].Value`;
                    const hiddenId = row.querySelector('input[type="hidden"]');
                    if (hiddenId) {
                        hiddenId.name = `Contacts[${i}].Id`;
                    }
                });
            }

            updateRemoveButtons();
        })();
    </script>
}