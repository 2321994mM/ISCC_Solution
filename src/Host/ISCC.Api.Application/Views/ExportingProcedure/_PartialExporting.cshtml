 @model List<ISCC.Application.TradeProcedures.Dtos.ExportConstraintDto>


@{
      // The legacy code read a "Lang" request cookie here:
      //     var langCookies = Context.Request.Cookies.FirstOrDefault(c => c.Key == "Lang").Value;
      // No code in the legacy application ever wrote that cookie (the sole Cookies.Append
      // in the whole solution is commented out, and it was for "UserId"), so
      // FirstOrDefault() always returned null and the trailing .Value always threw
      // NullReferenceException. This page could therefore never render for any visitor.
      // Culture is now resolved by RequestLocalizationMiddleware, so read that instead.
      // The Arabic and English string literals below are left exactly as they were.
      var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;}

@{
    if (Model != null && Model.Count > 0)
    {
        <div class="row">
			
				<table id="resultsTable" class="table table-bordered">
					<thead>
						<tr>
							@* <th scope="col">ID</th> *@
						<th scope="col">اسم الدولة</th>
						<th scope="col">اسم النبات</th>
						<th scope="col">الاسم المختصر</th>
						<th scope="col">الشروط بالعربية</th>
						<th scope="col">الشروط بالانجليزيه</th>
						<th scope="col">الشهاده بالعربية</th>
						<th scope="col">الشهاده بالانجليزيه</th>
						</tr>
					</thead>
					<tbody>
					@foreach (var item in @Model)
					{
						<tr>
							<td>@item.CountryName</td>
							<td>@item.ItemName</td>
							<td>@item.ShortNameAr</td>
							<td>@item.ConstrainTextAr</td>
							<td>@item.ConstrainTextEn</td>
                            <!-- ================================= -->
                            <!-- الشهادة بالعربية -->
                            <!-- ================================= -->

                            <td class="certificate-cell">

                                <div class="certificate-preview">

                                    @item.InSideCertificateAr

                                </div>


                                @if (!string.IsNullOrWhiteSpace(item.InSideCertificateAr)
                                                    && item.InSideCertificateAr.Length > 100)
                                {

                                    <button type="button"
                                            class="btn btn-link btn-sm show-certificate"
                                            data-title="الشهادة بالعربية"
                                            data-content="@item.InSideCertificateAr">

                                        عرض المزيد

                                    </button>

                                }

                            </td>


                            <!-- ================================= -->
                            <!-- الشهادة بالإنجليزية -->
                            <!-- ================================= -->

                            <td class="certificate-cell">

                                <div class="certificate-preview"
                                     dir="ltr">

                                    @item.InSideCertificateEn

                                </div>


                                @if (!string.IsNullOrWhiteSpace(item.InSideCertificateEn)
                                                    && item.InSideCertificateEn.Length > 100)
                                {

                                    <button type="button"
                                            class="btn btn-link btn-sm show-certificate"
                                            data-title="Certificate"
                                            data-content="@item.InSideCertificateEn">

                                        عرض المزيد

                                    </button>

                                }
                            </td>							
						</tr>
					}

					</tbody>
				</table>
			</div>
        
    }
    else
    {
        <div class="row">
            <div class="col-md-12 text-center">
				<img src="~/img/no-data.png" />
                <p class="text-bold">@(lang == "ar" ? "لا يوجد بيانات" : "No Data Found")</p>
            </div>
        </div>
    }
}
