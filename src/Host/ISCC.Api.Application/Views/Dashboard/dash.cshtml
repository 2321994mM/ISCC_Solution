@model ISCC.Application.Dashboard.Dtos.DashboardDto
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.0"></script>
@{
    ViewData["Title"] = "الإحصائيات";
}
<div class="container gov-dashboard">
    <div class="gov-dashboard__header">
        <h2 class="gov-dashboard__title">لوحة الإحصائيات</h2>
        <p class="gov-dashboard__subtitle">مؤشرات الوارد والصادر والجهات المسجلة لسنة @Model.Year</p>
    </div>
    <div class="row gov-dashboard-grid">
        <div class="col-lg-4">
            <section class="gov-chart-card">
                <canvas id="myChart2" class="gov-chart-canvas"></canvas>
            </section>
        </div>
        <div class="col-lg-4">
            <section class="gov-chart-card">
                <canvas id="myChart1" class="gov-chart-canvas"></canvas>
            </section>
        </div>
        <div class="col-lg-4">
            <section class="gov-chart-card">
                <canvas id="myChart3" class="gov-chart-canvas"></canvas>
            </section>
        </div>
        <div class="col-lg-4">
            <section class="gov-chart-card">
                <canvas id="myChart4" class="gov-chart-canvas"></canvas>
            </section>
        </div>
        <div class="col-lg-4">
            <section class="gov-chart-card">
                <canvas id="myChart" class="gov-chart-canvas"></canvas>
            </section>
        </div>
    </div>
</div>
<script>
    /* ====================== BAR CHART ====================== */
    const xValues = ["الشركات ", "الهيئات", "الأفراد"];
    const yValues = [
        @Model.CompanyNationalCount,
        @Model.PublicOrganizationCount,
        @Model.PeopleCount
    ];
    const barColors = ["#0d2d4d", "#2e6f57", "#b88a2d", "#5c6f82", "#0f6c8d"];
    Chart.defaults.font.family = "'Cairo-Regular', Tahoma, Arial, sans-serif";
    Chart.defaults.color = "#17212b";

    const ctx = document.getElementById('myChart');
    new Chart(ctx, {
        type: "bar",
        data: {
            labels: xValues,
            datasets: [{
                backgroundColor: barColors,
                data: yValues
            }]
        },
        options: {
            plugins: {
                legend: { display: false },
                title: {
                    display: true,
                    text: "التغيرات بالنسبة للأفراد والهيئات والشركات"+@Model.Year,
                    font: { size: 16 }
                }
            }
        }
    });


    /* ====================== LINE CHART ====================== */
    


    /* ====================== PIE CHART (COUNTRIES) ====================== */
    const xValuesCountries = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ImportCountries.Select(x => x.Label)));

    const yValuesCountries = [
        @foreach (var item in Model.ImportCountries)
        {
                <text>@item.TonnageTonnes.ToString("0", System.Globalization.CultureInfo.InvariantCulture),</text>
        }
    ];

    const ctx1 = document.getElementById('myChart1');
    new Chart(ctx1, {
        type: "pie",
        data: {
            labels: xValuesCountries,
            datasets: [{
                backgroundColor: barColors,
                data: yValuesCountries
            }]
        },
        options: {
            plugins: {
                legend: { display: true },
                title: {
                    display: true,
                    text: "أعلى خمس دول بالنسبة للوارد"+@Model.Year,
                    font: { size: 16 }
                }
            }
        }
    });


    /* ====================== DOUGHNUT CHART (PRODUCTS) ====================== */
    const xValuesproducts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ImportProducts.Select(x => x.Label)));

    const yValuesProducts = [
        @foreach (var item in Model.ImportProducts)
        {
                <text>@item.TonnageTonnes.ToString("0", System.Globalization.CultureInfo.InvariantCulture),</text>
        }
    ];

    const ctx2 = document.getElementById('myChart2');
    new Chart(ctx2, {
        type: "doughnut",
        data: {
            labels: xValuesproducts,
            datasets: [{
                backgroundColor: barColors,
                data: yValuesProducts
            }]
        },
        options: {
            plugins: {
                legend: { display: true },
                title: {
                    display: true,
                    text: "أعلى أربع منتجات بالنسبة للوارد لسنة "+@Model.Year,
                    font: { size: 16 }
                }
            }
        }
    });


    /* ====================== DOUGHNUT CHART (PRODUCTS) ====================== */
    const xValuesproductsEX = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExportProducts.Select(x => x.Label)));

     const yValuesProductsEX = [
         @foreach (var item in Model.ExportProducts)
         {
                     <text>@item.TonnageTonnes.ToString("0", System.Globalization.CultureInfo.InvariantCulture),</text>
         }
     ];

     const ctx3 = document.getElementById('myChart3');
     new Chart(ctx3, {
         type: "doughnut",
         data: {
             labels: xValuesproductsEX,
             datasets: [{
                 backgroundColor: barColors,
                 data: yValuesProductsEX
             }]
         },
         options: {
             plugins: {
                 legend: { display: true },
                 title: {
                     display: true,
                     text: "أعلى أربع منتجات بالنسبة للصادر"+@Model.Year,
                     font: { size: 16 }
                 }
             }
         }
     });

     /* ====================== PIE CHART (COUNTRIES) ====================== */
    const xValuesCountriesEX = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExportCountries.Select(x => x.Label)));


    const yValuesCountriesEX = [
        @foreach (var item in Model.ExportCountries)
        {
                    <text>@item.TonnageTonnes.ToString("0", System.Globalization.CultureInfo.InvariantCulture),</text>
        }
    ];

    const ctx4 = document.getElementById('myChart4');
    new Chart(ctx4, {
        type: "pie",
        data: {
            labels: xValuesCountriesEX,
            datasets: [{
                backgroundColor: barColors,
                data: yValuesCountriesEX
            }]
        },
        options: {
            plugins: {
                legend: { display: true },
                title: {
                    display: true,
                    text: "أعلى خمس دول بالنسبة للصادر"+@Model.Year,
                    font: { size: 16 }
                }
            }
        }
    });
</script>



