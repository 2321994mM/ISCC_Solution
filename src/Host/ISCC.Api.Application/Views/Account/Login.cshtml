@model ISCC.Api.Application.Controllers.LoginViewModel
@*
    Ported from PlantQuarantine.NewMvc/Views/Account/Login.cshtml.

    Kept from the original: the split panel, the brand block, the login-options row, the
    full-width submit button, and client-side validation via _ValidationScriptsPartial.

    Changed:

      - Every string is a localizer key. The original hardcoded Arabic, so an English user
        saw an Arabic page.
      - The decorative panel carried a hardcoded "96%" incoming-consignment inspection rate
        and a plant-health card. Both were invented placeholder content. Not ported: a
        fabricated operational statistic on a real sign-in page is something a user could
        believe. The panel now carries branding and nothing invented.
      - The password input is never given a value attribute, so a rejected sign-in does
        not echo the credential into the HTML and the browser's back-forward cache.
      - Field labels and messages are written out with @L rather than taken from
        [Display]/[ErrorMessage]. The tag helpers render those attributes verbatim, so a
        localization key in them appears on the page as the key itself.
*@
@{
    ViewData["Title"] = L["Login_Title"];
    ViewData["BodyClass"] = "login-page";

    var userNameError = ViewData.ModelState.TryGetValue("UserName", out var un) && un.Errors.Count > 0;
    var passwordError = ViewData.ModelState.TryGetValue("Password", out var pw) && pw.Errors.Count > 0;
}

<section class="login-shell">
    <div class="login-panel">
        <div class="login-brand">
            <span class="brand-mark large">PQ</span>
            <div>
                <p>@L["Login_BrandLine"]</p>
                <h1>@L["Login_Title"]</h1>
            </div>
        </div>

        <form asp-action="Login" method="post" class="login-form" novalidate>
            <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <label asp-for="UserName" class="form-label">@L["Login_Username"]</label>
            <input asp-for="UserName" class="form-control" autocomplete="username"
                   placeholder="@L["Login_UsernamePlaceholder"]"
                   aria-invalid="@(userNameError ? "true" : null)" autofocus />
            @if (userNameError)
            {
                <span class="field-error">@L["Login_UsernameRequired"]</span>
            }

            <label asp-for="Password" class="form-label">@L["Login_Password"]</label>
            @* No value: never round-trip the submitted password back into the markup. *@
            <input type="password" id="Password" name="Password" class="form-control"
                   autocomplete="current-password" placeholder="@L["Login_PasswordPlaceholder"]"
                   aria-invalid="@(passwordError ? "true" : null)" />
            @if (passwordError)
            {
                <span class="field-error">@L["Login_PasswordRequired"]</span>
            }

            <div class="login-options">
                <label class="check-row">
                    <input asp-for="RememberMe" />
                    <span>@L["Login_RememberMe"]</span>
                </label>
                @* The original had <a href="#">here</a>, a link to nothing. Rendered as
                   inert text so the row keeps its shape without offering a dead end. *@
                <span class="disabled-text" aria-disabled="true">@L["Login_ForgotPassword"]</span>
            </div>

            <button class="btn btn-primary login-button" type="submit">@L["Login_Button"]</button>
        </form>
    </div>

    <div class="login-visual" aria-hidden="true">
        <div class="plant-card">
            <span></span>
            <b>@L["Login_VisualTitle"]</b>
            <small>@L["Login_VisualBody"]</small>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}