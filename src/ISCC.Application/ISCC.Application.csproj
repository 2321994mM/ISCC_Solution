<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ISCC.Application</RootNamespace>
    <AssemblyName>ISCC.Application</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ISCC.Domain\ISCC.Domain.csproj" />

    <!--
      For SelectOption, the bilingual dropdown type. ISCC.Shared.Contracts is a leaf
      project with no references of its own, so this is a sideways reference and creates
      no cycle. Reusing SelectOption rather than declaring a second option type in
      ReferenceData/Dtos keeps one definition of the bilingual contract: the legacy code
      had three separate lookup shapes (LookupOptionViewModel, SelectOption, and raw
      {Value, Text} tuples) and every shared select component now depends on this one.
    -->
    <ProjectReference Include="..\ISCC.Shared.Contracts\ISCC.Shared.Contracts.csproj" />
  </ItemGroup>

  <!--
    AutoMapper and FluentValidation were removed in Phase 0. AutoMapper 13.0.1 carries
    the unpatched advisory GHSA-rvv3-g6hj-g44x (NU1903) and its only profile mapped
    entities that do not exist in the database. Re-add when real request DTOs exist.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
